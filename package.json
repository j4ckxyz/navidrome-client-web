{
  "name": "tonearm",
  "version": "0.2.2",
  "description": "A modern, desktop-first web client for Navidrome and Jellyfin music libraries",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "bun run server/index.ts",
    "test:e2e": "playwright test",
    "test:remote": "bun --conditions=browser run harness/remote.harness.ts",
    "test:lyrics": "bun --conditions=browser run harness/lrclib.test.ts",
    "test:radio": "bun --conditions=browser run harness/radio.test.ts",
    "test:userstats": "bun --conditions=browser run harness/userstats.test.ts",
    "test:live": "bun --conditions=browser --env-file=.env run harness/live.ts",
    "test:live:target": "bun --conditions=browser --env-file=.env run harness/live-target.ts",
    "test:live:control": "bun --conditions=browser --env-file=.env run harness/live-control.ts",
    "test:live:sessions": "bun --conditions=browser --env-file=.env run harness/dump-sessions.ts",
    "test:live:self": "bun --conditions=browser --env-file=.env run harness/self-check.ts",
    "typecheck": "tsc --noEmit",
    "update": "bun run scripts/update.ts",
    "compose:up": "COMMIT_HASH=$(git rev-parse HEAD) docker compose up -d --build",
    "desktop:icons": "bunx tauri icon public/icons/icon-512.png",
    "desktop:dev": "bun run desktop:icons && bunx tauri dev",
    "desktop:build": "bun run desktop:icons && bunx tauri build"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.7",
    "@solidjs/router": "^0.15.3",
    "@tanstack/solid-query": "^5.66.0",
    "@tanstack/solid-virtual": "^3.13.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "fflate": "^0.8.3",
    "hono": "^4.12.26",
    "jsqr": "^1.4.0",
    "lucide-solid": "^1.21.0",
    "music-metadata": "^11.13.0",
    "qrcode": "^1.5.4",
    "solid-js": "^1.9.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-solid": "^2.11.0",
    "@tauri-apps/cli": "^2.8.5"
  }
}
