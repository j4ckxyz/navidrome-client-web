{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tonearm",
  "version": "0.2.1",
  "identifier": "app.tonearm.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Tonearm",
      "width": 1280,
      "height": 800,
      "minWidth": 840,
      "minHeight": 600,
      "decorations": true,
      "transparent": false
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Music",
    "shortDescription": "Fast Navidrome and Jellyfin music player",
    "longDescription": "Tonearm is a fast native desktop client for Navidrome and Jellyfin music libraries, with downloads for offline listening.",
    "publisher": "Tonearm contributors",
    "homepage": "https://github.com/j4ckxyz/navidrome-client-web",
    "copyright": "Copyright (c) Tonearm contributors",
    "macOS": {
      "minimumSystemVersion": "15.0",
      "signingIdentity": "-"
    },
    "linux": { "appimage": { "bundleMediaFramework": false } },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "both",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEOEZDRjE2OUREOUJGNkYKUldSdnY5bWRGcytQTGJOeUVvZW1QMFE4RE42VDlLVXlDeDBOcnFkd0xRMjlmdTNFVnhHcS9pZkEK",
      "endpoints": [
        "https://github.com/j4ckxyz/navidrome-client-web/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
